# vim: ft=kconfig
mainmenu "NavHAL Configuration System"

# Platform selection (arch / vendor / family / board) is contributed by
# per-port Kconfig fragments under each port's own source tree (M7 §7.2),
# glob-sourced below. Adding an MCU is purely additive: drop the fragment
# files into src/arch, src/vendor, src/board — no edits to this file.
#
# Each choice sources the ports' "Kconfig.choice" members. Their
# mutual-exclusion default falls out of the `depends on` chain
# (arch ▶ vendor ▶ family ▶ board): exactly one member is visible per
# parent selection, and a choice auto-selects its single visible member.
# Where a parent has two or more visible members the tie is broken by a
# "default X if PARENT" on the choice below — otherwise source order decides,
# which shifts under anyone who adds a port.

menu "Target Platform Configuration"

choice
    prompt "Processor Architecture"
    default ARCH_CORTEX_M4
    help
      Select the target processor architecture.
source "src/arch/*/Kconfig.choice"
endchoice

choice
    prompt "Vendor"
    help
      Select the silicon vendor.
source "src/vendor/*/Kconfig.choice"
endchoice

choice
    prompt "Vendor Device Family"
    help
      Select the device family within the selected vendor. This is the
      register-layout axis: a single vendor can ship multiple families
      with different register maps (STM32F4 vs STM32F0 vs ...).
source "src/vendor/*/family/*/Kconfig.choice"
endchoice

choice
    prompt "Target Board"
    # A choice with several visible members defaults to the first one sourced,
    # i.e. alphabetically — so once a family has more than one board the default
    # moves whenever a board is added. A choice default has to be a property of
    # the choice itself (it does not parse inside a sourced member fragment), so
    # a family that ships more than one board names its reference board here.
    default BOARD_NUCLEO_F401RE if FAMILY_STM32F4
    help
      Select the target development board.
source "src/board/*/Kconfig.choice"
endchoice

# Per-port identity strings (ARCH_ISA / VENDOR / FAMILY / BOARD /
# CMAKE_SYSTEM_PROCESSOR) and per-arch build defaults.
source "src/arch/*/Kconfig"
source "src/vendor/*/Kconfig"
source "src/vendor/*/family/*/Kconfig"
source "src/board/*/Kconfig"

endmenu

menu "System & Features Configuration"

# Arch-specific peripheral toggles (FPU, DMA, DWT, ...) ship with their
# arch under src/arch/<isa>/Kconfig.features. osource: not every arch has
# arch-specific features.
osource "src/arch/*/Kconfig.features"

config DRV_CRC
    bool "Enable CRC support"
    default n
    help
      Provides the hal_crc_* API. Backed by the hardware CRC unit on STM32
      (Cortex-M4/M7); on the ATmega328P, which has no CRC peripheral, it is a
      bitwise software CRC-32 fallback.

endmenu

menu "HAL Drivers Configuration"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_AVR8 || ARCH_X86_64

config DRV_CLOCK
    bool "Enable Clock Driver"
    default y

config DRV_INTERRUPT
    bool "Enable Interrupt Driver"
    default y

config DRV_GPIO
    bool "Enable GPIO Driver"
    default y

config DRV_TIMER
    bool "Enable Timer Driver"
    default y
    select DRV_CLOCK
    # The MCU timer peripheral raises an update IRQ via the NVIC. The x86
    # timebase is polled TSC (no IRQ), so the interrupt select is MCU-only;
    # the PIT-IRQ timer path arrives with the x86 interrupt slice.
    select DRV_INTERRUPT if ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_AVR8

config DRV_UART
    bool "Enable UART Driver"
    default y
    # MCU UARTs need pin-mux (GPIO), a clock gate, and the NVIC. The PC 16550
    # is a fixed I/O-port device needing none of these, so the selects are
    # gated to the MCU arches.
    select DRV_GPIO if ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_AVR8
    select DRV_CLOCK if ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_AVR8
    select DRV_INTERRUPT if ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_AVR8

config DRV_UART_DMA
    bool "Enable DMA-backed UART API"
    default y if DRV_UART && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    depends on DRV_UART && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    select DRV_DMA
    help
      Compile the hal_uart_write_dma / init_dma_rx variants. Disable to
      drop the DMA backend from a DMA-enabled build (e.g. to save flash
      when DMA is only used by other drivers). Enabling this is what pulls
      DRV_DMA in for the UART driver on Cortex-M4/M7 — DRV_UART itself does
      not require DMA.

config DRV_I2C
    bool "Enable I2C Driver"
    default n
    select DRV_CLOCK
    select DRV_INTERRUPT

config DRV_I2C_DMA
    bool "Enable DMA-backed I2C API"
    default y if DRV_I2C && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    depends on DRV_I2C && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    select DRV_DMA
    help
      Compile hal_i2c_read_regs_dma. Disable to drop the DMA backend
      from a DMA-enabled I2C build. On the F7 the read phase uses the
      CR1.RXDMAEN request with AUTOEND framing.

config DRV_SPI
    bool "Enable SPI Driver"
    default n
    select DRV_GPIO
    select DRV_TIMER

config DRV_ADC
    bool "Enable ADC Driver"
    default n
    select DRV_CLOCK
    select DRV_GPIO

config DRV_PWM
    bool "Enable PWM Driver"
    default n
    select DRV_CLOCK
    select DRV_TIMER

config DRV_SDIO
    bool "Enable SDIO Driver"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    select DRV_CLOCK
    select DRV_GPIO
    select DRV_INTERRUPT
    select DRV_TIMER

config DRV_SDIO_DMA
    bool "Enable DMA-backed SDIO async API"
    default y if DRV_SDIO && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    depends on DRV_SDIO && (ARCH_CORTEX_M4 || ARCH_CORTEX_M7)
    select DRV_DMA
    help
      Compile the hal_sdio_*_async block-transfer variants. Disable to
      restrict SDIO to the polled (synchronous) API.

      The F7 SDMMC IP is register-identical to the F4 SDIO and shares the
      same driver, so the async path is available on both cores. DMA buffers
      are coherent while the L1 D-cache is disabled (the current default);
      when it is enabled they must be cleaned/invalidated or placed in DTCM
      (NAVHAL_DTCM_NOINIT).

config DRV_RTC
    bool "Enable RTC Driver"
    # F4 only: rtc.c includes family/rtc_reg.h and family/exti_reg.h, which
    # exist under stm32f4 alone. The F7 RTC is near enough the same IP that the
    # driver should port, but until those headers land, offering the symbol on
    # M7 only buys a build that fails at the first include.
    depends on FAMILY_STM32F4
    default n
    select DRV_CLOCK
    select DRV_INTERRUPT
    help
      Compile the hal_rtc_* API: a calendar in the always-on backup domain that
      keeps time across a reset, plus its 20 backup registers. Runs from the
      board's 32.768 kHz crystal when there is one, otherwise the internal RC.

config DRV_USB_CDC
    bool "Enable USB CDC-ACM Device Driver"
    depends on FAMILY_STM32F4
    default n
    select DRV_CLOCK
    select DRV_GPIO
    select DRV_INTERRUPT
    help
      Compile the hal_usb_cdc_* API: the target enumerates as a USB full-speed
      virtual serial port (/dev/ttyACM0) on the OTG_FS peripheral. Requires the
      RCC PLL Q output to be exactly 48 MHz; hal_usb_cdc_init() refuses to run
      otherwise.

config DRV_FLASH
    bool "Enable Flash Driver"
    default n

config DRV_ETH
    bool "Enable Ethernet MAC Driver"
    depends on ARCH_CORTEX_M7
    default n
    select DRV_CLOCK
    select DRV_GPIO
    select DRV_INTERRUPT
    help
      Compile the frame-level Ethernet MAC API (hal_eth_*). The MAC uses its
      own dedicated DMA with descriptor rings, independent of DRV_DMA. RMII/MII
      GPIOs and the PHY (MDIO) are brought up by the driver. Cortex-M7 only
      (the STM32F767 ETH IP).

endmenu

menu "Build Options"

# Per-arch toolchain identity: the prompt lives here (shared, overridable
# in menuconfig); each arch contributes its "default ... if ARCH_*" under
# src/arch/<isa>/Kconfig.
config TOOLCHAIN_PREFIX
    string "Toolchain Binary Prefix"
    help
      Prefix for the toolchain binaries (e.g. arm-none-eabi-, avr-).

config STANDALONE
    bool "Build Standalone Samples (without full HAL)"
    default n

# Sample selection lives in samples/Kconfig (M7 §7.3). Adding a new
# sample is one edit there, no root-Kconfig change.
source "samples/Kconfig"


config TEST
    bool "Build Unit Tests"
    default n

config FLASHER
    string "Binary Flasher Tool"

config FLASH_ADDRESS
    string "Flash Target Address"

endmenu
