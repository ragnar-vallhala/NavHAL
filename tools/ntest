# ============================================================================
# TUI (curses)
# ============================================================================
_ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")


class _TuiAction:
    """One runnable tier. We drive it by re-invoking ourselves as a subprocess
    (`ntest <argv>`) and streaming its output into a pane — so nothing ever
    leaves curses and each tier keeps its own live log + result."""

    def __init__(self, label, argv):
        self.label, self.argv = label, argv
        self.status = "idle"          # idle | running | pass | fail | skip
        self.log = []                 # decoded, ANSI-stripped lines
        self.result = ""              # scraped one-line summary

    GLYPH = {"idle": "·", "running": "▶", "pass": "✔", "fail": "✘", "skip": "–"}
    PAIR = {"idle": 4, "running": 3, "pass": 1, "fail": 2, "skip": 3}


def _tui_build_actions():
    specs = [("host  · SIL", ["host"])]
    for b in boards_for("pil"):
        specs.append((f"pil   · {b}", ["pil", b]))
    for b in boards_for("hil"):
        specs.append((f"hil   · {b}", ["hil", b]))
    for lbl, a in (("m4", "m4"), ("m7", "m7"), ("avr", "avr")):
        specs.append((f"sample· {lbl}", ["samples", a]))
    specs.append(("cap-contract", ["cap-contract"]))
    specs.append(("coverage", ["coverage"]))
    return [_TuiAction(lbl, argv) for lbl, argv in specs]


def run_tui(args):
    try:
        import curses
    except ImportError:
        die("curses unavailable; use `ntest all`")

    actions = _tui_build_actions()
    self_path = os.path.abspath(__file__)

    def spawn(a):
        a.status, a.log, a.result = "running", [], ""
        env = dict(os.environ, PYTHONUNBUFFERED="1", NO_COLOR="1")
        p = subprocess.Popen([sys.executable, self_path, *a.argv], cwd=REPO,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
        os.set_blocking(p.stdout.fileno(), False)
        return p

    def drain(p, a, rbuf):
        """Pull whatever's ready off the pipe into a.log; return leftover bytes."""
        eof = False
        while True:
            try:
                chunk = os.read(p.stdout.fileno(), 65536)
            except (BlockingIOError, InterruptedError):
                break
            if chunk == b"":
                eof = True
                break
            rbuf += chunk
            *lines, rbuf = rbuf.split(b"\n")
            for ln in lines:
                a.log.append(_ANSI.sub("", ln.decode(errors="replace")).rstrip())
        return rbuf, eof

    def finalize(p, a, rbuf):
        if rbuf.strip():
            a.log.append(_ANSI.sub("", rbuf.decode(errors="replace")).rstrip())
        rc = p.returncode
        # scrape the summary table / totals the child printed
        joined = "\n".join(a.log)
        skipped = "SKIP no board" in joined
        m = re.findall(r"(PASS|FAIL)\s+(\d+)/(\d+)", joined)
        if m:
            tot = sum(int(x[2]) for x in m)
            passed = sum(int(x[1]) for x in m)
            a.result = f"{passed}/{tot} across {len(m)} suite(s)"
        else:
            mm = re.search(r"lines:\s*([\d.]+)%", joined)
            a.result = f"lines {mm.group(1)}%" if mm else "(no summary)"
        a.status = "skip" if (rc == 0 and skipped) else ("pass" if rc == 0 else "fail")
        if skipped:
            a.result = "no board attached"

    def loop(scr):
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_RED, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
        curses.init_pair(4, -1, -1)
        scr.timeout(80)

        sel = 0
        proc = None
        running = None
        rbuf = b""
        queue = []
        foff = 0          # log scroll: lines held back from the tail (0 = follow)

        def put(y, x, s, attr=0, maxx=None):
            h, w = scr.getmaxyx()
            if y < 0 or y >= h or x >= w:
                return
            s = s[: (maxx if maxx is not None else w) - x]
            if x + len(s) >= w:            # never touch the bottom-right cell
                s = s[: w - x - 1]
            try:
                scr.addstr(y, x, s, attr)
            except curses.error:
                pass

        def box(y0, x0, y1, x1, title, focus):
            tattr = curses.A_BOLD | (curses.color_pair(3) if focus else 0)
            put(y0, x0, "┌" + "─" * (x1 - x0 - 1) + "┐")
            for y in range(y0 + 1, y1):
                put(y, x0, "│"); put(y, x1, "│")
            put(y1, x0, "└" + "─" * (x1 - x0 - 1) + "┘")
            put(y0, x0 + 2, f" {title} ", tattr)

        while True:
            # ---- pump the running child -------------------------------------
            if proc:
                rbuf, eof = drain(proc, actions[running], rbuf)
                if proc.poll() is not None and eof:
                    finalize(proc, actions[running], rbuf)
                    proc, running, rbuf = None, None, b""
            if proc is None and queue:
                running = queue.pop(0)
                proc = spawn(actions[running])
                sel, foff = running, 0

            # ---- draw -------------------------------------------------------
            scr.erase()
            h, w = scr.getmaxyx()
            Lw = max(22, min(40, w // 3))
            busy = actions[running].label if running is not None else None
            head = "ntest"
            put(0, 0, head, curses.A_BOLD)
            put(0, len(head) + 2,
                (f"running {busy}…" if busy else "idle"),
                curses.color_pair(3) if busy else curses.A_DIM)
            foot = " ↑↓ move · ⏎/r run · a all · x stop · ⇧J/K scroll · g/G ends · q quit "
            put(h - 1, 0, foot, curses.A_DIM)

            splity = max(6, h - 8)            # result box gets ~7 rows
            body_bot = h - 2
            # panes
            box(1, 0, splity - 1, Lw, "tests", False)
            box(splity, 0, body_bot, Lw, "result", False)
            log_focus = foff > 0
            box(1, Lw + 1, body_bot, w - 1, "logs", log_focus)

            # tests list
            for i, a in enumerate(actions):
                y = 2 + i
                if y >= splity - 1:
                    break
                g = _TuiAction.GLYPH[a.status]
                attr = curses.color_pair(_TuiAction.PAIR[a.status])
                sattr = curses.A_REVERSE if i == sel else attr
                put(y, 2, f"{g} {a.label}", sattr, maxx=Lw)

            # result of the selected action
            a = actions[sel]
            put(splity + 1, 2, a.label, curses.A_BOLD, maxx=Lw)
            st = a.status.upper()
            put(splity + 2, 2, st, curses.color_pair(_TuiAction.PAIR[a.status]), maxx=Lw)
            if a.result:
                for k, seg in enumerate(_wrap(a.result, Lw - 3)):
                    put(splity + 3 + k, 2, seg, 0, maxx=Lw)

            # logs of the selected action (auto-follow tail unless scrolled)
            log = actions[sel].log
            rows = body_bot - 2
            top = max(0, len(log) - rows - foff)
            view = log[top: top + rows]
            for k, ln in enumerate(view):
                put(2 + k, Lw + 2, ln, 0, maxx=w - 1)

            scr.refresh()

            # ---- input ------------------------------------------------------
            ch = scr.getch()
            if ch == -1:
                continue
            if ch in (ord("q"), 27):
                if proc:
                    proc.terminate()
                break
            elif ch in (curses.KEY_DOWN, ord("j")):
                sel = (sel + 1) % len(actions); foff = 0
            elif ch in (curses.KEY_UP, ord("k")):
                sel = (sel - 1) % len(actions); foff = 0
            elif ch in (curses.KEY_ENTER, 10, 13, ord("r")):
                if actions[sel].status != "running" and sel not in queue:
                    queue.append(sel)
            elif ch == ord("a"):
                for i in range(len(actions)):
                    if actions[i].status != "running" and i not in queue:
                        queue.append(i)
            elif ch == ord("x"):
                if proc:
                    proc.terminate()
                    actions[running].status = "fail"
                    actions[running].result = "stopped"
                    proc, running, rbuf, queue = None, None, b"", []
            elif ch in (curses.KEY_PPAGE, ord("K")):
                foff += max(1, (h - 4) // 2)
            elif ch in (curses.KEY_NPAGE, ord("J")):
                foff = max(0, foff - max(1, (h - 4) // 2))
            elif ch == ord("g"):
                foff = 10 ** 9
            elif ch == ord("G"):
                foff = 0

    curses.wrapper(loop)
    return []


def _wrap(s, width):
    return [s[i:i + width] for i in range(0, len(s), max(1, width))] or [""]


# ============================================================================
# CLI
# ============================================================================
def main():
    p = argparse.ArgumentParser(prog="ntest", description="NavHAL test orchestrator")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("host", help="SIL host suites")
    sp.add_argument("--logic-only", action="store_true")
    sp.add_argument("--drivers-only", action="store_true")
    sp.set_defaults(fn=run_host)

    sp = sub.add_parser("pil", help="emulator (Renode/simavr)")
    sp.add_argument("board", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every PIL board")
    sp.set_defaults(fn=run_pil)

    sp = sub.add_parser("hil", help="real board")
    sp.add_argument("board", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every HIL board")
    sp.set_defaults(fn=run_hil)

    sp = sub.add_parser("samples", help="build sample matrix")
    sp.add_argument("arch", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every arch")
    sp.set_defaults(fn=run_samples)

    sp = sub.add_parser("cap-contract", help="capability symbol contract")
    sp.set_defaults(fn=run_cap_contract)

    sp = sub.add_parser("coverage", help="host gcov coverage")
    sp.add_argument("--gate", action="store_true", help="fail below floors")
    sp.set_defaults(fn=run_coverage)

    sp = sub.add_parser("all", help="everything runnable here")
    sp.add_argument("--hil", action="store_true", help="also flash attached boards")
    sp.set_defaults(fn=run_all)

    sub.add_parser("list", help="show catalog").set_defaults(fn=run_list)
    sub.add_parser("tui", help="interactive").set_defaults(fn=run_tui)

    args = p.parse_args()
    if not args.cmd:
        # bare invocation: TUI on a terminal, else run everything
        if sys.stdin.isatty() and sys.stdout.isatty():
            return run_tui(args) or sys.exit(0)
        args.fn = run_all
        args.hil = False

    results = args.fn(args)
    if not results:  # list / tui
        sys.exit(0)
    ok = summary(results)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
