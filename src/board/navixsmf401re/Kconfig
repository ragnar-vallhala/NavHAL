# Card detect is an ordinary GPIO, not an SDIO signal, so it can be anywhere.
# Its presence is the flag: a board that declares it gets BOARD_SD_CD in the
# generated header, and the driver compiles its card-detect path on that.
config PIN_BOARD_SD_CD_PORT
    int
    default 2 if BOARD_NAVIXSM_F401RE
config PIN_BOARD_SD_CD_PIN
    int
    default 5 if BOARD_NAVIXSM_F401RE

# ---- USART pins ----
# Which pins each USART uses, and the alternate function that routes it. A
# USART this board leaves undescribed is absent from the driver's pin table, so
# the driver configures no pins for it.
#
# Constrained by the AF mux: each USART reaches only a few pin pairs. Check the
# datasheet before changing one, and set the AF that table gives.

