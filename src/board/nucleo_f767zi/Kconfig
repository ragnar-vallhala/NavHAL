# ---- USART pins ----
# Which pins each USART uses, and the alternate function that routes it. A
# USART this board leaves undescribed is absent from the driver's pin table, so
# the driver configures no pins for it.
#
# Constrained by the AF mux: each USART reaches only a few pin pairs. Check the
# datasheet before changing one, and set the AF that table gives.

config PIN_BOARD_USART1_TX_PORT
    int
    default 1 if BOARD_NUCLEO_F767ZI
