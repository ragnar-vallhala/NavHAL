# ---- Second UART ----
# Which instance code should use when it needs a UART that is not the console,
# such as a two-port bridge. Its pins are the BOARD_USART<n>_* set above.
#
# On this board that is the same instance BOARD_GPS_UART names, so a bridge and
# the GPS contend for one port; point this at another USART to run both.
config VAL_BOARD_AUX_UART
    string
    default "HAL_UART_6" if BOARD_NAVIXSM_F401RE

# Whether BOARD_AUX_UART is free for a sample to drive. A board that has already
# committed that instance to a peripheral says n, and samples needing two UARTs
# of their own drop out rather than fighting it.
config BOARD_AUX_UART_SPARE
    bool
    default n if BOARD_NAVIXSM_F401RE

# No ADC input and no user button are wired on this board, so it declares neither
# VAL_BOARD_ADC / VAL_BOARD_ADC_PIN / NUM_BOARD_ADC_CHANNEL nor USER_BUTTON. That
# is the hardware, not an omission: 33_hal_adc and 02_hal_pupd decline this board
# and the sample matrix reports them n/a, which is the right answer rather than a
# gap to fill. Written down because the absence looks identical to a forgotten
# declaration, and the matrix will ask again every time a board is added.
