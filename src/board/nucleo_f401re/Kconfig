# vim: ft=kconfig
# Board identity string for Nucleo-F401RE (M7 §7.2). Sourced at top level.

config BOARD
    string
    default "nucleo_f401re" if BOARD_NUCLEO_F401RE

# ---- This board's description ----
#
# Every macro board.h used to define, as Kconfig symbols; tools/kconfig.py turns
# them into the board.h that code includes, so this file is the single place the
# board is described and any value can be overridden in .config.
#
# PIN_<name>_PORT/_PIN become HAL_GPIO_PIN(); NUM_<name> an integer; VAL_<name> is
# emitted verbatim, for spellings no integer can carry.

