# ntest — the NavHAL test orchestrator.
#
# One entry point over every test tier so you don't juggle a dozen scripts:
#
#     ntest host                 SIL — host unit + real-driver-on-host suites
#     ntest pil   <board|--all>  PIL — build + run in the emulator (Renode/simavr)
#     ntest hil   <board|--all>  HIL — build + flash + capture a real board
#     ntest samples <arch|--all> build every sample the arch admits
#     ntest cap-contract         link-time capability symbol contract
#     ntest coverage [--gate]    host gcov/gcovr line coverage (+ optional floor)
#     ntest all [--hil]          everything runnable here
#     ntest list                 the catalog (boards, host suites, arches)
#     ntest                      interactive TUI (a TTY) / `all` (piped)
#
# It reads the existing board registry (tools/{hil,pil}/boards/*.conf), owns the
# single `cmake -DTEST=ON` recipe and the one `Total failures:` parser, and
# shells to the emulator backends (tools/renode, tools/simavr) and st-flash.
# Zero third-party deps except pyserial (only for `hil`, only when a board is
# attached) and gcovr (only for `coverage`).

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HIL_BOARDS = os.path.join(REPO, "tools", "hil", "boards")
PIL_BOARDS = os.path.join(REPO, "tools", "pil", "boards")

# Per top-level src/ area floor (%). --gate fails if a covered area drops below.
COVERAGE_FLOORS = {}  # e.g. {"src/vendor/stm32": 60.0}; empty = report only.

# ----------------------------------------------------------------------------
# tiny terminal colour
# ----------------------------------------------------------------------------
_TTY = sys.stdout.isatty()


def c(s, col):
    if not _TTY:
        return s
    codes = {"g": 32, "r": 31, "y": 33, "b": 34, "d": 2, "bold": 1}
    return f"\033[{codes[col]}m{s}\033[0m"


def hdr(s):
    print(c(f"\n== {s} ==", "bold"))


def die(msg, code=2):
    sys.stderr.write(f"ntest: {msg}\n")
    sys.exit(code)


def run(cmd, **kw):
    """Run a command, streaming to our stdout. Returns the CompletedProcess."""
    kw.setdefault("cwd", REPO)
    return subprocess.run(cmd, **kw)


def run_cap(cmd, timeout=None, **kw):
    """Run capturing combined output; returns (rc, text)."""
    kw.setdefault("cwd", REPO)
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout, **kw)
        return p.returncode, p.stdout.decode(errors="replace")
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode(errors="replace")
        return 124, out


# ----------------------------------------------------------------------------
# board registry — merge tools/{hil,pil}/boards/*.conf into one view
# ----------------------------------------------------------------------------
def _parse_conf(path):
    """Parse a KEY=VALUE shell conf (quotes stripped) into a dict."""
    d = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip()
            if len(v) >= 2 and v[0] in "\"'" and v[-1] == v[0]:
                v = v[1:-1]
            d[k] = v
    return d


def registry():
    """{board: {"hil": {...} or None, "pil": {...} or None}}"""
    reg = {}
    for mode, d in (("hil", HIL_BOARDS), ("pil", PIL_BOARDS)):
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".conf"):
                continue
            board = fn[:-5]
            reg.setdefault(board, {"hil": None, "pil": None})
            reg[board][mode] = _parse_conf(os.path.join(d, fn))
    return reg


def boards_for(mode):
    return [b for b, m in sorted(registry().items()) if m.get(mode)]


# ----------------------------------------------------------------------------
# config resolver — seed .config = DEFCONFIG + extra caps, restore after
# ----------------------------------------------------------------------------
class ConfigScope:
    """Stash .config, write DEFCONFIG + TEST_EXTRA_CONFIG, restore on exit."""

    def __init__(self, defconfig, extra=""):
        self.defconfig = os.path.join(REPO, defconfig)
        self.extra = extra
        self.saved = None
        self.dotcfg = os.path.join(REPO, ".config")

    def __enter__(self):
        if os.path.exists(self.dotcfg):
            self.saved = tempfile.mktemp()
            shutil.move(self.dotcfg, self.saved)
        with open(self.defconfig) as f:
            body = f.read()
        for kv in self.extra.split():
            body += kv + "\n"
        with open(self.dotcfg, "w") as f:
            f.write(body)
        return self

    def __exit__(self, *exc):
        if self.saved and os.path.exists(self.saved):
            shutil.move(self.saved, self.dotcfg)
        elif os.path.exists(self.dotcfg):
            os.remove(self.dotcfg)


# ----------------------------------------------------------------------------
# the one build recipe
# ----------------------------------------------------------------------------
def build_test_elf(build_dir, toolchain, quiet=True):
    """cmake -DTEST=ON [toolchain] && cmake --build --target tests. .config must
    already be seeded by a ConfigScope. Returns (ok, build_path)."""
    bp = os.path.join(REPO, build_dir)
    shutil.rmtree(bp, ignore_errors=True)
    cfg = ["cmake", "-B", build_dir, "-DTEST=ON"]
    if toolchain:
        cfg.append(f"-DCMAKE_TOOLCHAIN_FILE={toolchain}")
    out = subprocess.DEVNULL if quiet else None
    if run(cfg, stdout=out, stderr=out).returncode != 0:
        return False, bp
    if run(["cmake", "--build", build_dir, "--target", "tests", "-j"],
           stdout=out, stderr=out).returncode != 0:
        return False, bp
    return True, bp


# ----------------------------------------------------------------------------
# navtest output parser (the single source of truth for pass/fail)
# ----------------------------------------------------------------------------
_SUM_FAIL = re.compile(r"Total failures:\s*(\d+)")
_SUM_TOT = re.compile(r"Total tests run:\s*(\d+)")
_SUITE = re.compile(r"\[(\d+) tests \| (\d+) failed \| (\d+) passed\]")


def parse_navtest(text):
    """-> (found_summary, total, failures). failures=None if no summary line."""
    mf = _SUM_FAIL.search(text)
    mt = _SUM_TOT.search(text)
    if not mf:
        # host binaries have no 'Total failures' line; fall back to suite lines
        tot = fail = 0
        seen = False
        for m in _SUITE.finditer(text):
            seen = True
            tot += int(m.group(1))
            fail += int(m.group(2))
        return seen, tot, (fail if seen else None)
    return True, (int(mt.group(1)) if mt else 0), int(mf.group(1))


# ----------------------------------------------------------------------------
# result model + summary table
# ----------------------------------------------------------------------------
class Result:
    def __init__(self, name, ok, total=None, failed=None, note=""):
        self.name, self.ok, self.total, self.failed, self.note = \
            name, ok, total, failed, note


def summary(results):
    print(c("\n== summary ==", "bold"))
    w = max((len(r.name) for r in results), default=8)
    anyfail = False
    for r in results:
        if r.ok:
            tag = c("PASS", "g")
        else:
            tag = c("FAIL", "r")
            anyfail = True
        cnt = ""
        if r.total is not None:
            cnt = f"{r.total - (r.failed or 0)}/{r.total}"
        print(f"  {r.name.ljust(w)}  {tag}  {cnt.ljust(9)} {c(r.note, 'd')}")
    return not anyfail


# ============================================================================
# RUNNERS
# ============================================================================
def run_host(args):
    """SIL: build + run tests_host and tests_host_drivers."""
    hdr("host / SIL")
    bp = os.path.join(REPO, "build-host")
    shutil.rmtree(bp, ignore_errors=True)
    if run(["cmake", "-B", "build-host", "-S", "tests/host"],
           stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("host", False, note="configure failed")]
    if run(["cmake", "--build", "build-host", "-j"],
           stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("host", False, note="build failed")]
    results = []
    exes = ["tests_host", "tests_host_drivers"]
    if getattr(args, "logic_only", False):
        exes = ["tests_host"]
    if getattr(args, "drivers_only", False):
        exes = ["tests_host_drivers"]
    for exe in exes:
        path = os.path.join(bp, exe)
        if not os.path.exists(path):
            results.append(Result(exe, False, note="not built"))
            continue
        rc, out = run_cap([path])
        sys.stdout.write(out)
        _, tot, fail = parse_navtest(out)
        fail = fail if fail is not None else (0 if rc == 0 else rc)
        results.append(Result(exe, rc == 0 and fail == 0, tot, fail))
    return results


def _emu_backend(board, conf):
    """Build the test ELF for a PIL board and run it via its RUNNER, return Result."""
    tc = conf.get("TOOLCHAIN_FILE")
    bd = conf.get("BUILD_DIR", f"build-pil-{board}")
    runner = conf.get("RUNNER")
    if not (tc and runner):
        return Result(f"pil:{board}", False, note="conf missing TOOLCHAIN_FILE/RUNNER")
    print(c(f"-- pil:{board} — build ({conf.get('ARCH','?')})", "d"))
    with ConfigScope(conf["DEFCONFIG"], conf.get("TEST_EXTRA_CONFIG", "")):
        ok, bp = build_test_elf(bd, tc)
    if not ok:
        return Result(f"pil:{board}", False, note="build failed")
    elf = os.path.join(bp, "tests")
    env = dict(os.environ)
    if conf.get("RESC"):
        env["RESC"] = conf["RESC"]
    print(c(f"-- pil:{board} — {os.path.basename(runner)}", "d"))
    rc, out = run_cap([os.path.join(REPO, runner), elf], timeout=300, env=env)
    _, tot, fail = parse_navtest(out)
    if fail is None:
        return Result(f"pil:{board}", False, note="no summary (emu timeout?)")
    return Result(f"pil:{board}", fail == 0, tot, fail)


def run_pil(args):
    hdr("pil / emulator")
    reg = registry()
    targets = boards_for("pil") if (args.all or args.board in (None, "all")) else [args.board]
    if not targets:
        die("no PIL boards")
    out = []
    for b in targets:
        conf = reg.get(b, {}).get("pil")
        if not conf:
            out.append(Result(f"pil:{b}", False, note="no pil conf"))
            continue
        out.append(_emu_backend(b, conf))
    return out


# --- HIL: chip-id probe + flash + serial capture ---------------------------
def _st_probe(chipid):
    """Return (stlink_serial, ttyACM_port) for a connected probe whose target
    matches chipid, or (None, None)."""
    rc, out = run_cap(["st-info", "--probe"])
    if rc != 0:
        return None, None
    serial = None
    cur = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("serial:"):
            cur = line.split()[1]
        elif line.startswith("chipid:") and cur:
            if line.split()[1].lower() == chipid.lower():
                serial = cur
                break
    if not serial:
        return None, None
    for p in sorted(_glob_ttyacm()):
        rc, info = run_cap(["udevadm", "info", "-q", "property", "-n", p])
        for line in info.splitlines():
            if line.startswith("ID_SERIAL_SHORT=") and line.split("=", 1)[1] == serial:
                return serial, p
    return serial, None


def _glob_ttyacm():
    import glob
    return glob.glob("/dev/ttyACM*")


def _serial_capture(port, baud, timeout_s):
    """Read until 'Total failures: N'; stream to stdout. -> (text, failures|None)."""
    try:
        import serial
    except ImportError:
        die("pyserial not installed (apt install python3-serial)", 2)
    ser = serial.Serial(port, baud, timeout=1)
    deadline = time.time() + timeout_s
    buf = b""
    rx = re.compile(rb"Total failures:\s*(\d+)")
    while time.time() < deadline:
        chunk = ser.read(1024)
        if not chunk:
            continue
        sys.stdout.buffer.write(chunk)
        sys.stdout.flush()
        buf += chunk
        m = rx.search(buf)
        if m:
            ser.close()
            txt = buf.decode(errors="replace")
            mt = re.search(r"Total tests run:\s*(\d+)", txt)
            return txt, int(m.group(1)), (int(mt.group(1)) if mt else None)
    ser.close()
    return buf.decode(errors="replace"), None, None


def _hil_one(board, conf):
    chipid = conf.get("CHIPID")
    tc = conf.get("TOOLCHAIN_FILE")
    bd = conf.get("BUILD_DIR", f"build-hil-{board}")
    if not (chipid and tc and conf.get("DEFCONFIG")):
        return Result(f"hil:{board}", False, note="conf missing CHIPID/TOOLCHAIN/DEFCONFIG")
    serial, port = _st_probe(chipid)
    if not serial:
        return Result(f"hil:{board}", True, note=c("SKIP no board", "y"))  # honest skip
    if not port:
        return Result(f"hil:{board}", False, note="probe found, no ttyACM")
    print(c(f"-- hil:{board} — probe {serial} @ {port} — build", "d"))
    with ConfigScope(conf["DEFCONFIG"], conf.get("TEST_EXTRA_CONFIG", "")):
        ok, bp = build_test_elf(bd, tc)
    if not ok:
        return Result(f"hil:{board}", False, note="build failed")
    elf = os.path.join(bp, "tests")
    binp = elf + ".bin"
    objcopy = "arm-none-eabi-objcopy"
    if run([objcopy, "-O", "binary", elf, binp], stdout=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="objcopy failed")
    faddr = conf.get("FLASH_ADDR", "0x08000000")
    print(c(f"-- hil:{board} — flash {faddr}", "d"))
    if run(["st-flash", "--serial", serial, "--reset", "write", binp, faddr],
           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="flash failed")
    baud = int(conf.get("BAUD", "9600"))
    to = int(conf.get("TIMEOUT", "120"))
    print(c(f"-- hil:{board} — capture {port} @ {baud}", "d"))
    _, fail, tot = _serial_capture(port, baud, to)
    if fail is None:
        return Result(f"hil:{board}", False, note="capture timeout")
    return Result(f"hil:{board}", fail == 0, total=tot, failed=fail)


def run_hil(args):
    hdr("hil / hardware")
    reg = registry()
    targets = boards_for("hil") if (args.all or args.board in (None, "all")) else [args.board]
    if not targets:
        die("no HIL boards")
    return [_hil_one(b, reg[b]["hil"]) if reg.get(b, {}).get("hil")
            else Result(f"hil:{b}", False, note="no hil conf") for b in targets]


# --- samples ---------------------------------------------------------------
ARCH_TOOLCHAIN = {
    "ARCH_CORTEX_M4": None,  # default toolchain
    "ARCH_CORTEX_M7": "cmake/toolchains/arm-none-eabi-f767-toolchain.cmake",
    "ARCH_AVR8": "cmake/toolchains/avr-toolchain.cmake",
}
ARCH_ALIASES = {"m4": "ARCH_CORTEX_M4", "f401": "ARCH_CORTEX_M4",
                "m7": "ARCH_CORTEX_M7", "f767": "ARCH_CORTEX_M7",
                "avr": "ARCH_AVR8", "atmega": "ARCH_AVR8"}


def _samples_for(arch):
    rc, out = run_cap([os.path.join(REPO, "tools", "samples_for_arch.sh"), arch])
    return out.split() if rc == 0 else []


def _sample_matrix(arch):
    tc = ARCH_TOOLCHAIN[arch]
    slugs = _samples_for(arch)
    if not slugs:
        return Result(f"samples:{arch}", False, note="no samples")
    bd = "build-ntest-sample"
    npass = nfail = 0
    fails = []
    for slug in slugs:
        shutil.rmtree(os.path.join(REPO, bd), ignore_errors=True)
        if os.path.exists(os.path.join(REPO, ".config")):
            os.remove(os.path.join(REPO, ".config"))
        cfg = ["cmake", "-B", bd, "-DSAMPLE=" + slug]
        if tc:
            cfg.append(f"-DCMAKE_TOOLCHAIN_FILE={tc}")
        okc = run(cfg, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        okb = okc and run(["cmake", "--build", bd, "-j"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if okb:
            npass += 1
            print("  " + c("OK  ", "g") + slug)
        else:
            nfail += 1
            fails.append(slug)
            print("  " + c("FAIL", "r") + " " + slug)
    shutil.rmtree(os.path.join(REPO, bd), ignore_errors=True)
    if os.path.exists(os.path.join(REPO, ".config")):
        os.remove(os.path.join(REPO, ".config"))
    note = ("failed: " + " ".join(fails)) if fails else ""
    return Result(f"samples:{arch.replace('ARCH_', '').lower()}", nfail == 0,
                  npass + nfail, nfail, note)


def run_samples(args):
    hdr("samples")
    if args.all or args.arch in (None, "all"):
        arches = ["ARCH_CORTEX_M4", "ARCH_CORTEX_M7", "ARCH_AVR8"]
    else:
        a = ARCH_ALIASES.get(args.arch.lower(), args.arch.upper())
        if a not in ARCH_TOOLCHAIN:
            die(f"unknown arch '{args.arch}' (m4|m7|avr)")
        arches = [a]
    return [_sample_matrix(a) for a in arches]


# --- cap-contract: link-time symbol presence/absence -----------------------
# Orchestrates the standalone test_cap_contract.sh (its 3-scenario nm checks are
# self-contained; ntest just fronts it, as it does the emulator backends).
def run_cap_contract(args):
    hdr("capability contract")
    script = os.path.join(REPO, "tools", "test_cap_contract.sh")
    if not os.path.exists(script):
        return [Result("cap-contract", False, note="script missing")]
    rc, out = run_cap([script])
    sys.stdout.write(out)
    m = re.search(r"pass=(\d+)\s+fail=(\d+)", out)
    if m:
        npass, nfail = int(m.group(1)), int(m.group(2))
        return [Result("cap-contract", rc == 0 and nfail == 0, npass + nfail, nfail)]
    return [Result("cap-contract", rc == 0)]


# --- coverage: host gcov + gcovr ------------------------------------------
def run_coverage(args):
    hdr("coverage / host gcov")
    if not shutil.which("gcovr"):
        die("gcovr not installed (pip install gcovr)")
    bd = "build-host-cov"
    bp = os.path.join(REPO, bd)
    shutil.rmtree(bp, ignore_errors=True)
    covflags = "--coverage -O0 -g"
    cfg = ["cmake", "-B", bd, "-S", "tests/host",
           f"-DCMAKE_C_FLAGS={covflags}", f"-DCMAKE_EXE_LINKER_FLAGS=--coverage"]
    if run(cfg, stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("coverage", False, note="configure failed")]
    if run(["cmake", "--build", bd, "-j"], stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("coverage", False, note="build failed")]
    for exe in ("tests_host", "tests_host_drivers"):
        p = os.path.join(bp, exe)
        if os.path.exists(p):
            run_cap([p])  # generate .gcda
    rc, out = run_cap(["gcovr", "--root", REPO, "--filter", "src/",
                       "--print-summary", "--decisions", bd])
    sys.stdout.write(out)
    # parse the gcovr 'lines: NN.N%' summary line
    m = re.search(r"lines:\s*([\d.]+)%", out)
    pct = float(m.group(1)) if m else 0.0
    ok = True
    if getattr(args, "gate", False) and COVERAGE_FLOORS:
        rc2, jout = run_cap(["gcovr", "--root", REPO, "--filter", "src/",
                             "--json-summary", bd])
        ok = _coverage_gate(jout)
    shutil.rmtree(bp, ignore_errors=True)
    return [Result("coverage", ok, note=f"lines {pct:.1f}%")]


def _coverage_gate(json_text):
    import json
    try:
        data = json.loads(json_text)
    except Exception:
        return True
    agg = {}
    for f in data.get("files", []):
        fn = f.get("filename", "")
        for area in COVERAGE_FLOORS:
            if fn.startswith(area):
                a = agg.setdefault(area, [0, 0])
                a[0] += f.get("line_covered", 0)
                a[1] += f.get("line_total", 0)
    ok = True
    for area, floor in COVERAGE_FLOORS.items():
        cov, tot = agg.get(area, [0, 0])
        pct = 100.0 * cov / tot if tot else 100.0
        tag = "ok" if pct >= floor else "BELOW FLOOR"
        if pct < floor:
            ok = False
        print(f"  {area:28} {pct:5.1f}%  floor {floor:5.1f}  {tag}")
    return ok


# --- all / list ------------------------------------------------------------
def run_all(args):
    results = []
    results += run_host(args)
    for a in ("ARCH_CORTEX_M4", "ARCH_CORTEX_M7", "ARCH_AVR8"):
        results.append(_sample_matrix(a))
    results += run_cap_contract(args)
    for b in boards_for("pil"):
        conf = registry()[b]["pil"]
        results.append(_emu_backend(b, conf))
    if getattr(args, "hil", False):
        for b in boards_for("hil"):
            results.append(_hil_one(b, registry()[b]["hil"]))
    return results


def run_list(args):
    reg = registry()
    print(c("boards:", "bold"))
    for b, m in sorted(reg.items()):
        modes = ",".join(k for k in ("hil", "pil") if m.get(k))
        arch = (m.get("hil") or m.get("pil") or {}).get("ARCH", "?")
        print(f"  {b:22} arch={arch:10} modes=[{modes}]")
    print(c("\nhost suites:", "bold"))
    print("  tests_host, tests_host_drivers")
    print(c("\nsample arches:", "bold"))
    print("  m4, m7, avr")
    return []


# ============================================================================
# TUI (curses)
# ============================================================================
def run_tui(args):
    try:
        import curses
    except ImportError:
        die("curses unavailable; use `ntest all`")

    reg = registry()
    # actions: (label, callable-returning-results)
    ns = argparse.Namespace(hil=False)
    actions = [("host / SIL", lambda: run_host(ns))]
    for b in boards_for("pil"):
        actions.append((f"pil  {b}", (lambda bb=b: [_emu_backend(bb, reg[bb]['pil'])])))
    for b in boards_for("hil"):
        actions.append((f"hil  {b}", (lambda bb=b: [_hil_one(bb, reg[bb]['hil'])])))
    for a, lbl in (("ARCH_CORTEX_M4", "samples m4"),
                   ("ARCH_CORTEX_M7", "samples m7"), ("ARCH_AVR8", "samples avr")):
        actions.append((lbl, (lambda aa=a: [_sample_matrix(aa)])))
    actions.append(("cap-contract", lambda: run_cap_contract(ns)))
    actions.append(("coverage", lambda: run_coverage(ns)))

    state = {i: None for i in range(len(actions))}  # Result or None

    def draw(scr, sel):
        scr.erase()
        h, w = scr.getmaxyx()
        scr.addstr(0, 0, "ntest — enter/r run · a all · q quit"[:w - 1], curses.A_BOLD)
        for i, (label, _) in enumerate(actions):
            r = state[i]
            if r is None:
                glyph, attr = "· ", curses.A_DIM
            elif r.ok:
                glyph, attr = "✔ ", curses.color_pair(1)
            else:
                glyph, attr = "✘ ", curses.color_pair(2)
            cnt = ""
            if r and r.total is not None:
                cnt = f"  {r.total - (r.failed or 0)}/{r.total}"
            if r and r.note:
                cnt += "  " + r.note
            line = f"{glyph}{label}{cnt}"
            mode = curses.A_REVERSE if i == sel else attr
            scr.addstr(2 + i, 2, line[:w - 3], mode)
        scr.addstr(h - 1, 0, "results stream below when running…"[:w - 1], curses.A_DIM)
        scr.refresh()

    def _curses_run(i):
        # run outside curses so the runner's stdout streams normally
        curses.endwin()
        print(c(f"\n>>> {actions[i][0]}", "bold"))
        try:
            res = actions[i][1]()
            state[i] = res[0] if res else Result(actions[i][0], True)
        except Exception as e:
            state[i] = Result(actions[i][0], False, note=str(e))
        input(c("\n[enter] back to ntest", "d"))

    def loop(scr):
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_RED, -1)
        sel = 0
        while True:
            draw(scr, sel)
            ch = scr.getch()
            if ch in (ord("q"), 27):
                break
            elif ch in (curses.KEY_DOWN, ord("j")):
                sel = (sel + 1) % len(actions)
            elif ch in (curses.KEY_UP, ord("k")):
                sel = (sel - 1) % len(actions)
            elif ch in (curses.KEY_ENTER, 10, 13, ord("r")):
                _curses_run(sel)
            elif ch == ord("a"):
                for i in range(len(actions)):
                    _curses_run(i)

    curses.wrapper(loop)
    return []


# ============================================================================
# CLI
# ============================================================================
def main():
    p = argparse.ArgumentParser(prog="ntest", description="NavHAL test orchestrator")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("host", help="SIL host suites")
    sp.add_argument("--logic-only", action="store_true")
    sp.add_argument("--drivers-only", action="store_true")
    sp.set_defaults(fn=run_host)

    sp = sub.add_parser("pil", help="emulator (Renode/simavr)")
    sp.add_argument("board", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every PIL board")
    sp.set_defaults(fn=run_pil)

    sp = sub.add_parser("hil", help="real board")
    sp.add_argument("board", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every HIL board")
    sp.set_defaults(fn=run_hil)

    sp = sub.add_parser("samples", help="build sample matrix")
    sp.add_argument("arch", nargs="?", default=None)
    sp.add_argument("--all", action="store_true", help="every arch")
    sp.set_defaults(fn=run_samples)

    sp = sub.add_parser("cap-contract", help="capability symbol contract")
    sp.set_defaults(fn=run_cap_contract)

    sp = sub.add_parser("coverage", help="host gcov coverage")
    sp.add_argument("--gate", action="store_true", help="fail below floors")
    sp.set_defaults(fn=run_coverage)

    sp = sub.add_parser("all", help="everything runnable here")
    sp.add_argument("--hil", action="store_true", help="also flash attached boards")
    sp.set_defaults(fn=run_all)

    sub.add_parser("list", help="show catalog").set_defaults(fn=run_list)
    sub.add_parser("tui", help="interactive").set_defaults(fn=run_tui)

    args = p.parse_args()
    if not args.cmd:
        # bare invocation: TUI on a terminal, else run everything
        if sys.stdin.isatty() and sys.stdout.isatty():
            return run_tui(args) or sys.exit(0)
        args.fn = run_all
        args.hil = False

    results = args.fn(args)
    if not results:  # list / tui
        sys.exit(0)
    ok = summary(results)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
