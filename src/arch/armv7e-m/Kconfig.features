# vim: ft=kconfig
# Arch-specific peripheral toggles for the armv7e-m ISA (M7 §7.2).
# Sourced inside the root "System & Features Configuration" menu.
#
# DMA, the hardware FPU, the DWT cycle counter and the FPU runtime are
# Cortex-M peripherals with no ATmega328P equivalent, so they live with
# the arch rather than in the common root. (AVR ships no Kconfig.features
# fragment — there is nothing arch-specific to toggle there yet.)

config USE_FPU
    bool "Enable Hardware FPU Compiler Flags"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    help
      Enable hardware Floating Point Unit compiler and linker flags.

config DRV_DMA
    bool "Enable Direct Memory Access (DMA)"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    select DRV_INTERRUPT
    help
      Enables support for the DMA hardware controller.

config DRV_DWT
    bool "Enable Debug Watchpoint and Trace (DWT)"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    help
      Enables the DWT counter for high-resolution timing.

config DRV_FPU
    bool "Enable FPU Driver Extension"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    help
      Enables compilation of hardware FPU runtime setup files.

config DRV_MPU
    bool "Enable Memory Protection Unit (MPU)"
    depends on ARCH_CORTEX_M4 || ARCH_CORTEX_M7
    default n
    help
      Enables the ARMv7-M Memory Protection Unit driver (region-based
      access control). Region count is silicon-dependent (8 on M4,
      16 on M7) and read at runtime from MPU_TYPE.DREGION.

config DRV_CACHE
    bool "Enable L1 cache driver (Cortex-M7)"
    depends on ARCH_CORTEX_M7
    default n
    help
      Enables the hal_cache driver for the Cortex-M7 L1 caches: the
      instruction cache (hal_icache_enable, a hazard-free performance win) and
      the data cache (hal_dcache_enable plus the clean/invalidate maintenance
      the DMA drivers use to stay coherent). The Cortex-M4 has no L1 cache, so
      this option is not offered there.

config CACHE_AT_BOOT
    bool "Turn the L1 caches on before main()"
    depends on DRV_CACHE
    default y
    help
      Enables the instruction and data caches in the startup path, so an
      application gets them without asking. Measured on a Nucleo-F767ZI at
      216 MHz, a flash-resident workload runs 2.7x faster with both on.

      Both, or neither: with only one enabled the other path still stalls on
      flash and the stalls dominate -- the instruction cache alone measured
      slightly slower than no cache at all (samples/cortex-m/38_hal_flash_art).

      The data cache is only safe because every DMA path in the HAL maintains
      its buffers: eth cleans and invalidates its descriptors and frames, sdio
      and i2c go through navhal_dma_{tx_prepare,rx_guard,rx_finish}, and uart
      does the same plus hal_uart_dma_rx_sync for its ring. An application
      that hands its own buffer to a HAL DMA call is covered by those. One
      that drives a peripheral's DMA directly, or reads a ring the HAL filled,
      has to maintain that buffer itself -- turn this off if that is not done.

config USE_TCM
    bool "Enable tightly-coupled memory placement (Cortex-M7)"
    depends on ARCH_CORTEX_M7
    default n
    help
      Activates the NAVHAL_ITCM / NAVHAL_DTCM / NAVHAL_DTCM_NOINIT placement
      attributes (common/hal_tcm.h), letting code and data be pinned into the
      Cortex-M7's 0-wait instruction/data TCMs. The board startup copies the
      .itcm / .dtcm sections from flash at reset. M4 has no TCM, so this option
      is not offered there; with it off, the attributes are no-ops.
