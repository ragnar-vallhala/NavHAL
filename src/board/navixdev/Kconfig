    int
    default 8 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D1_PORT
    int
    default 2 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D1_PIN
    int
    default 9 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D2_PORT
    int
    default 2 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D2_PIN
    int
    default 10 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D3_PORT
    int
    default 2 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_D3_PIN
    int
    default 11 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_CK_PORT
    int
    default 2 if BOARD_NAVIXDEV
config PIN_BOARD_SDIO_CK_PIN
    int
    default 12 if BOARD_NAVIXDEV
