# NavHAL defconfig — bare-metal x86-64 / PC / QEMU.
#
# Selects the arch / vendor / family / board. A PC has none of the MCU
# peripherals (GPIO/SPI/I2C/ADC/PWM/timer-as-driver), so only UART is on;
# the rest cascade off. Seeded by cmake/toolchains/x86_64-qemu-toolchain.cmake.

CONFIG_ARCH_X86_64=y
CONFIG_VENDOR_PC=y
CONFIG_FAMILY_PC=y
CONFIG_BOARD_QEMU=y

CONFIG_DRV_UART=y
CONFIG_DRV_CLOCK=y
CONFIG_DRV_INTERRUPT=y
# DRV_TIMER defaults y, but this port implements only the polled TSC timebase
# (hal_timebase_*), not the general-purpose hal_timer_* peripheral API, so it
# has no _hal_timer_ops table to offer. Claiming the driver would advertise a
# capability that is not there. Re-enable when the PIT-IRQ timer slice lands.
CONFIG_DRV_TIMER=n
# CONFIG_DRV_GPIO is not set
