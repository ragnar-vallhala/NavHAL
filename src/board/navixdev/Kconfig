    int
    default 2 if BOARD_NAVIXDEV

# Card detect is an ordinary GPIO, not an SDIO signal, so it can be anywhere.
# Its presence is the flag: a board that declares it gets BOARD_SD_CD in the
# generated header, and the driver compiles its card-detect path on that.
config PIN_BOARD_SD_CD_PORT
    int
    default 2 if BOARD_NAVIXDEV
config PIN_BOARD_SD_CD_PIN
    int
    default 5 if BOARD_NAVIXDEV
