# ---- SDIO ----
# The bus signals are fixed by the alternate-function mux rather than freely
# chosen: pointing one at a pin the mux cannot route gives a build that compiles
# and a bus that never transfers. Check the datasheet before changing one.
# No card socket is fitted, so no BOARD_SD_CD is declared and
# hal_sdio_card_present() answers true -- a slot that cannot be observed
# must not be reported empty.

config NUM_BOARD_SDIO_AF
    int
    default 12 if BOARD_NUCLEO_F767ZI
config PIN_BOARD_SDIO_D0_PORT
    int
    default 2 if BOARD_NUCLEO_F767ZI
