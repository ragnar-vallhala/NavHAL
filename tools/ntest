# RUNNERS
# ============================================================================
def run_host(args):
    """SIL: build + run tests_host and tests_host_drivers."""
    hdr("host / SIL")
    bp = os.path.join(REPO, "build-host")
    shutil.rmtree(bp, ignore_errors=True)
    if run(["cmake", "-B", "build-host", "-S", "tests/host"],
           stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("host", False, note="configure failed")]
    if run(["cmake", "--build", "build-host", "-j"],
           stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("host", False, note="build failed")]
    results = []
    exes = ["tests_host", "tests_host_drivers"]
    if getattr(args, "logic_only", False):
        exes = ["tests_host"]
    if getattr(args, "drivers_only", False):
        exes = ["tests_host_drivers"]
    for exe in exes:
        path = os.path.join(bp, exe)
        if not os.path.exists(path):
            results.append(Result(exe, False, note="not built"))
            continue
        rc, out = run_cap([path])
        sys.stdout.write(out)
        _, tot, fail = parse_navtest(out)
        fail = fail if fail is not None else (0 if rc == 0 else rc)
        results.append(Result(exe, rc == 0 and fail == 0, tot, fail))
    return results


def _emu_backend(board, conf):
    """Build the test ELF for a PIL board and run it via its RUNNER, return Result."""
    tc = conf.get("TOOLCHAIN_FILE")
    bd = conf.get("BUILD_DIR", f"build-pil-{board}")
    runner = conf.get("RUNNER")
    if not (tc and runner):
        return Result(f"pil:{board}", False, note="conf missing TOOLCHAIN_FILE/RUNNER")
    print(c(f"-- pil:{board} — build ({conf.get('ARCH','?')})", "d"))
    with ConfigScope(conf.get("DEFCONFIG"), conf.get("TEST_EXTRA_CONFIG", "")):
        ok, bp = build_test_elf(bd, tc)
    if not ok:
        return Result(f"pil:{board}", False, note="build failed")
    elf = os.path.join(bp, "tests")
    env = dict(os.environ)
    if conf.get("RESC"):
        env["RESC"] = conf["RESC"]
    print(c(f"-- pil:{board} — {os.path.basename(runner)}", "d"))
    rc, out = run_cap([os.path.join(REPO, runner), elf], timeout=300, env=env)
    _, tot, fail = parse_navtest(out)
    if fail is None:
        return Result(f"pil:{board}", False, note="no summary (emu timeout?)")
    return Result(f"pil:{board}", fail == 0, tot, fail)


def run_pil(args):
    hdr("pil / emulator")
    reg = registry()
    targets = boards_for("pil") if (args.all or args.board in (None, "all")) else [args.board]
    if not targets:
        die("no PIL boards")
    out = []
    for b in targets:
        conf = reg.get(b, {}).get("pil")
        if not conf:
            out.append(Result(f"pil:{b}", False, note="no pil conf"))
            continue
        out.append(_emu_backend(b, conf))
    return out


# --- HIL: chip-id probe + flash + serial capture ---------------------------
def _st_probe(chipid):
    """Return (stlink_serial, ttyACM_port) for a connected probe whose target
    matches chipid, or (None, None)."""
    rc, out = run_cap(["st-info", "--probe"])
    if rc != 0:
        return None, None
    serial = None
    cur = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("serial:"):
            cur = line.split()[1]
        elif line.startswith("chipid:") and cur:
            if line.split()[1].lower() == chipid.lower():
                serial = cur
                break
    if not serial:
        return None, None
    for p in sorted(_glob_ttyacm()):
        rc, info = run_cap(["udevadm", "info", "-q", "property", "-n", p])
        for line in info.splitlines():
            if line.startswith("ID_SERIAL_SHORT=") and line.split("=", 1)[1] == serial:
                return serial, p
    return serial, None


def _glob_ttyacm():
    import glob
    return glob.glob("/dev/ttyACM*")


def _port_vid(port):
    """USB idVendor of a tty (lowercase hex), or '' — how we fingerprint an AVR
    board's USB-serial bridge, the AVR analogue of an ST-Link chip-id."""
    rc, info = run_cap(["udevadm", "info", "-q", "property", "-n", port])
    for line in info.splitlines():
        if line.startswith("ID_VENDOR_ID="):
            return line.split("=", 1)[1].strip().lower()
    return ""


def _find_usb_serial(vids):
    """First /dev/ttyUSB*|ttyACM* whose USB idVendor is in `vids`, or None."""
    import glob
    want = {v.strip().lower() for v in vids if v.strip()}
    for p in sorted(glob.glob("/dev/ttyUSB*") + glob.glob("/dev/ttyACM*")):
        if _port_vid(p) in want:
            return p
    return None


def _serial_capture(port, baud, timeout_s, reset_dtr=False):
    """Read until 'Total failures: N'; stream to stdout. -> (text, failures|None)."""
    try:
        import serial
    except ImportError:
        die("pyserial not installed (apt install python3-serial)", 2)
    ser = serial.Serial(port, baud, timeout=1)
    if reset_dtr:
        # Arduino-style auto-reset: pulse DTR so the just-flashed program
        # restarts from main() while we're already listening.
        ser.dtr = False
        time.sleep(0.1)
        ser.reset_input_buffer()
        ser.dtr = True
    deadline = time.time() + timeout_s
    buf = b""
    rx = re.compile(rb"Total failures:\s*(\d+)")
    while time.time() < deadline:
        chunk = ser.read(1024)
        if not chunk:
            continue
        sys.stdout.buffer.write(chunk)
        sys.stdout.flush()
        buf += chunk
        m = rx.search(buf)
        if m:
            ser.close()
            txt = buf.decode(errors="replace")
            mt = re.search(r"Total tests run:\s*(\d+)", txt)
            return txt, int(m.group(1)), (int(mt.group(1)) if mt else None)
    ser.close()
    return buf.decode(errors="replace"), None, None


def _hil_one(board, conf):
    """Route to the ST-Link (ARM) or avrdude (AVR) flow by the board's ARCH."""
    if conf.get("ARCH", "").lower().startswith("avr"):
        return _hil_avr(board, conf)
    return _hil_arm(board, conf)


def _hil_avr(board, conf):
    """AVR HIL: match the board by USB vendor id, flash with avrdude, capture."""
    tc = conf.get("TOOLCHAIN_FILE")
    bd = conf.get("BUILD_DIR", f"build-hil-{board}")
    mcu = conf.get("MCU", "atmega328p")
    prog = conf.get("PROGRAMMER", "arduino")
    # CH340 (1a86) / FT232 (0403) / official Uno (2341) are the usual bridges.
    vids = conf.get("USB_VID", "1a86,0403,2341").split(",")
    if not tc:
        return Result(f"hil:{board}", False, note="conf missing TOOLCHAIN_FILE")
    port = conf["PORT"] if conf.get("PORT") and os.path.exists(conf.get("PORT", "")) \
        else _find_usb_serial(vids)
    if not port:
        return Result(f"hil:{board}", True, note=c("SKIP no board", "y"))  # honest skip
    print(c(f"-- hil:{board} — avr on {port} — build", "d"))
    with ConfigScope(conf.get("DEFCONFIG"), conf.get("TEST_EXTRA_CONFIG", "")):
        ok, bp = build_test_elf(bd, tc)
    if not ok:
        return Result(f"hil:{board}", False, note="build failed")
    elf = os.path.join(bp, "tests")
    hexp = elf + ".hex"
    if run(["avr-objcopy", "-O", "ihex", elf, hexp],
           stdout=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="objcopy failed")
    ubaud = conf.get("UPLOAD_BAUD", "115200")
    print(c(f"-- hil:{board} — avrdude -c {prog} -p {mcu} @ {ubaud}", "d"))
    flash = ["avrdude", "-c", prog, "-p", mcu, "-P", port, "-b", ubaud,
             "-D", "-U", f"flash:w:{hexp}:i"]
    if run(flash, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="avrdude flash failed")
    baud = int(conf.get("BAUD", "9600"))
    to = int(conf.get("TIMEOUT", "60"))
    print(c(f"-- hil:{board} — capture {port} @ {baud}", "d"))
    _, fail, tot = _serial_capture(port, baud, to, reset_dtr=True)
    if fail is None:
        return Result(f"hil:{board}", False, note="capture timeout")
    return Result(f"hil:{board}", fail == 0, total=tot, failed=fail)


def _hil_arm(board, conf):
    chipid = conf.get("CHIPID")
    tc = conf.get("TOOLCHAIN_FILE")
    bd = conf.get("BUILD_DIR", f"build-hil-{board}")
    if not (chipid and tc and conf.get("DEFCONFIG")):
        return Result(f"hil:{board}", False, note="conf missing CHIPID/TOOLCHAIN/DEFCONFIG")
    serial, port = _st_probe(chipid)
    if not serial:
        return Result(f"hil:{board}", True, note=c("SKIP no board", "y"))  # honest skip
    if not port:
        return Result(f"hil:{board}", False, note="probe found, no ttyACM")
    print(c(f"-- hil:{board} — probe {serial} @ {port} — build", "d"))
    with ConfigScope(conf["DEFCONFIG"], conf.get("TEST_EXTRA_CONFIG", "")):
        ok, bp = build_test_elf(bd, tc)
    if not ok:
        return Result(f"hil:{board}", False, note="build failed")
    elf = os.path.join(bp, "tests")
    binp = elf + ".bin"
    objcopy = "arm-none-eabi-objcopy"
    if run([objcopy, "-O", "binary", elf, binp], stdout=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="objcopy failed")
    faddr = conf.get("FLASH_ADDR", "0x08000000")
    print(c(f"-- hil:{board} — flash {faddr}", "d"))
    if run(["st-flash", "--serial", serial, "--reset", "write", binp, faddr],
           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        return Result(f"hil:{board}", False, note="flash failed")
    baud = int(conf.get("BAUD", "9600"))
    to = int(conf.get("TIMEOUT", "120"))
    print(c(f"-- hil:{board} — capture {port} @ {baud}", "d"))
    _, fail, tot = _serial_capture(port, baud, to)
    if fail is None:
        return Result(f"hil:{board}", False, note="capture timeout")
    return Result(f"hil:{board}", fail == 0, total=tot, failed=fail)


def run_hil(args):
    hdr("hil / hardware")
    reg = registry()
    targets = boards_for("hil") if (args.all or args.board in (None, "all")) else [args.board]
    if not targets:
        die("no HIL boards")
    return [_hil_one(b, reg[b]["hil"]) if reg.get(b, {}).get("hil")
            else Result(f"hil:{b}", False, note="no hil conf") for b in targets]


# --- samples ---------------------------------------------------------------
ARCH_TOOLCHAIN = {
    "ARCH_CORTEX_M4": None,  # default toolchain
    "ARCH_CORTEX_M7": "cmake/toolchains/arm-none-eabi-f767-toolchain.cmake",
    "ARCH_AVR8": "cmake/toolchains/avr-toolchain.cmake",
}
ARCH_ALIASES = {"m4": "ARCH_CORTEX_M4", "f401": "ARCH_CORTEX_M4",
                "m7": "ARCH_CORTEX_M7", "f767": "ARCH_CORTEX_M7",
                "avr": "ARCH_AVR8", "atmega": "ARCH_AVR8"}


def _samples_for(arch):
    rc, out = run_cap([os.path.join(REPO, "tools", "samples_for_arch.sh"), arch])
    return out.split() if rc == 0 else []


def _sample_matrix(arch):
    tc = ARCH_TOOLCHAIN[arch]
    slugs = _samples_for(arch)
    if not slugs:
        return Result(f"samples:{arch}", False, note="no samples")
    bd = "build-ntest-sample"
    npass = nfail = 0
    fails = []
    for slug in slugs:
        shutil.rmtree(os.path.join(REPO, bd), ignore_errors=True)
        if os.path.exists(os.path.join(REPO, ".config")):
            os.remove(os.path.join(REPO, ".config"))
        cfg = ["cmake", "-B", bd, "-DSAMPLE=" + slug]
        if tc:
            cfg.append(f"-DCMAKE_TOOLCHAIN_FILE={tc}")
        okc = run(cfg, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        okb = okc and run(["cmake", "--build", bd, "-j"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if okb:
            npass += 1
            print("  " + c("OK  ", "g") + slug)
        else:
            nfail += 1
            fails.append(slug)
            print("  " + c("FAIL", "r") + " " + slug)
    shutil.rmtree(os.path.join(REPO, bd), ignore_errors=True)
    if os.path.exists(os.path.join(REPO, ".config")):
        os.remove(os.path.join(REPO, ".config"))
    note = ("failed: " + " ".join(fails)) if fails else ""
    return Result(f"samples:{arch.replace('ARCH_', '').lower()}", nfail == 0,
                  npass + nfail, nfail, note)


def run_samples(args):
    hdr("samples")
    if args.all or args.arch in (None, "all"):
        arches = ["ARCH_CORTEX_M4", "ARCH_CORTEX_M7", "ARCH_AVR8"]
    else:
        a = ARCH_ALIASES.get(args.arch.lower(), args.arch.upper())
        if a not in ARCH_TOOLCHAIN:
            die(f"unknown arch '{args.arch}' (m4|m7|avr)")
        arches = [a]
    return [_sample_matrix(a) for a in arches]


# --- cap-contract: link-time symbol presence/absence -----------------------
# Orchestrates the standalone test_cap_contract.sh (its 3-scenario nm checks are
# self-contained; ntest just fronts it, as it does the emulator backends).
def run_cap_contract(args):
    hdr("capability contract")
    script = os.path.join(REPO, "tools", "test_cap_contract.sh")
    if not os.path.exists(script):
        return [Result("cap-contract", False, note="script missing")]
    rc, out = run_cap([script])
    sys.stdout.write(out)
    m = re.search(r"pass=(\d+)\s+fail=(\d+)", out)
    if m:
        npass, nfail = int(m.group(1)), int(m.group(2))
        return [Result("cap-contract", rc == 0 and nfail == 0, npass + nfail, nfail)]
    return [Result("cap-contract", rc == 0)]


# --- coverage: host gcov + gcovr ------------------------------------------
def run_coverage(args):
    hdr("coverage / host gcov")
    if not shutil.which("gcovr"):
        die("gcovr not installed (pip install gcovr)")
    bd = "build-host-cov"
    bp = os.path.join(REPO, bd)
    shutil.rmtree(bp, ignore_errors=True)
    covflags = "--coverage -O0 -g"
    cfg = ["cmake", "-B", bd, "-S", "tests/host",
           f"-DCMAKE_C_FLAGS={covflags}", f"-DCMAKE_EXE_LINKER_FLAGS=--coverage"]
    if run(cfg, stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("coverage", False, note="configure failed")]
    if run(["cmake", "--build", bd, "-j"], stdout=subprocess.DEVNULL).returncode != 0:
        return [Result("coverage", False, note="build failed")]
    for exe in ("tests_host", "tests_host_drivers"):
        p = os.path.join(bp, exe)
        if os.path.exists(p):
            run_cap([p])  # generate .gcda
    rc, out = run_cap(["gcovr", "--root", REPO, "--filter", "src/",
                       "--print-summary", "--decisions", bd])
    sys.stdout.write(out)
    # parse the gcovr 'lines: NN.N%' summary line
    m = re.search(r"lines:\s*([\d.]+)%", out)
    pct = float(m.group(1)) if m else 0.0
    ok = True
    if getattr(args, "gate", False) and COVERAGE_FLOORS:
        rc2, jout = run_cap(["gcovr", "--root", REPO, "--filter", "src/",
                             "--json-summary", bd])
        ok = _coverage_gate(jout)
    shutil.rmtree(bp, ignore_errors=True)
    return [Result("coverage", ok, note=f"lines {pct:.1f}%")]


def _coverage_gate(json_text):
    import json
    try:
        data = json.loads(json_text)
    except Exception:
        return True
    agg = {}
    for f in data.get("files", []):
        fn = f.get("filename", "")
        for area in COVERAGE_FLOORS:
            if fn.startswith(area):
                a = agg.setdefault(area, [0, 0])
                a[0] += f.get("line_covered", 0)
                a[1] += f.get("line_total", 0)
    ok = True
    for area, floor in COVERAGE_FLOORS.items():
        cov, tot = agg.get(area, [0, 0])
        pct = 100.0 * cov / tot if tot else 100.0
        tag = "ok" if pct >= floor else "BELOW FLOOR"
        if pct < floor:
            ok = False
        print(f"  {area:28} {pct:5.1f}%  floor {floor:5.1f}  {tag}")
    return ok


