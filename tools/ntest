# ntest — the NavHAL test orchestrator.
#
# One entry point over every test tier so you don't juggle a dozen scripts:
#
#     ntest host                 SIL — host unit + real-driver-on-host suites
#     ntest pil   <board|--all>  PIL — build + run in the emulator (Renode/simavr)
#     ntest hil   <board|--all>  HIL — build + flash + capture a real board
#     ntest samples <arch|--all> build every sample the arch admits
#     ntest cap-contract         link-time capability symbol contract
#     ntest coverage [--gate]    host gcov/gcovr line coverage (+ optional floor)
#     ntest all [--hil]          everything runnable here
#     ntest list                 the catalog (boards, host suites, arches)
#     ntest                      interactive TUI (a TTY) / `all` (piped)
#
# It reads the existing board registry (tools/{hil,pil}/boards/*.conf), owns the
# single `cmake -DTEST=ON` recipe and the one `Total failures:` parser, and
# shells to the emulator backends (tools/renode, tools/simavr) and st-flash.
# Zero third-party deps except pyserial (only for `hil`, only when a board is
# attached) and gcovr (only for `coverage`).

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HIL_BOARDS = os.path.join(REPO, "tools", "hil", "boards")
PIL_BOARDS = os.path.join(REPO, "tools", "pil", "boards")

# Per top-level src/ area floor (%). --gate fails if a covered area drops below.
COVERAGE_FLOORS = {}  # e.g. {"src/vendor/stm32": 60.0}; empty = report only.

# ----------------------------------------------------------------------------
# tiny terminal colour
# ----------------------------------------------------------------------------
_TTY = sys.stdout.isatty()


def c(s, col):
    if not _TTY:
        return s
    codes = {"g": 32, "r": 31, "y": 33, "b": 34, "d": 2, "bold": 1}
    return f"\033[{codes[col]}m{s}\033[0m"


def hdr(s):
    print(c(f"\n== {s} ==", "bold"))


def die(msg, code=2):
    sys.stderr.write(f"ntest: {msg}\n")
    sys.exit(code)


def run(cmd, **kw):
    """Run a command, streaming to our stdout. Returns the CompletedProcess."""
    kw.setdefault("cwd", REPO)
    return subprocess.run(cmd, **kw)


def run_cap(cmd, timeout=None, **kw):
    """Run capturing combined output; returns (rc, text)."""
    kw.setdefault("cwd", REPO)
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout, **kw)
        return p.returncode, p.stdout.decode(errors="replace")
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode(errors="replace")
        return 124, out


# ----------------------------------------------------------------------------
# board registry — merge tools/{hil,pil}/boards/*.conf into one view
# ----------------------------------------------------------------------------
def _parse_conf(path):
    """Parse a KEY=VALUE shell conf (quotes stripped) into a dict."""
    d = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip()
            if len(v) >= 2 and v[0] in "\"'" and v[-1] == v[0]:
                v = v[1:-1]
            d[k] = v
    return d


def registry():
    """{board: {"hil": {...} or None, "pil": {...} or None}}"""
    reg = {}
    for mode, d in (("hil", HIL_BOARDS), ("pil", PIL_BOARDS)):
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".conf"):
                continue
            board = fn[:-5]
            reg.setdefault(board, {"hil": None, "pil": None})
            reg[board][mode] = _parse_conf(os.path.join(d, fn))
    return reg


def boards_for(mode):
    return [b for b, m in sorted(registry().items()) if m.get(mode)]


# ----------------------------------------------------------------------------
# config resolver — seed .config = DEFCONFIG + extra caps, restore after
# ----------------------------------------------------------------------------
class ConfigScope:
    """Stash .config, write DEFCONFIG + TEST_EXTRA_CONFIG, restore on exit.

    defconfig may be None (e.g. the AVR PIL conf carries none): then we leave
    .config absent so the top-level CMake seeds it from the toolchain's
    NAVHAL_DEFCONFIG. Either way any pre-existing .config is stashed on the way
    in and restored on the way out — so a stale .config from an earlier run can
    never leak into this build."""

    def __init__(self, defconfig, extra=""):
        self.defconfig = os.path.join(REPO, defconfig) if defconfig else None
        self.extra = extra
        self.saved = None
        self.dotcfg = os.path.join(REPO, ".config")

    def __enter__(self):
        if os.path.exists(self.dotcfg):
            self.saved = tempfile.mktemp()
            shutil.move(self.dotcfg, self.saved)
        if self.defconfig:
            with open(self.defconfig) as f:
                body = f.read()
            for kv in self.extra.split():
                body += kv + "\n"
            with open(self.dotcfg, "w") as f:
                f.write(body)
        elif self.extra:
            # no base defconfig but caps requested: write just the caps (rare)
            with open(self.dotcfg, "w") as f:
                f.write("".join(kv + "\n" for kv in self.extra.split()))
        # else: leave .config absent -> CMake seeds from the toolchain defconfig
        return self

    def __exit__(self, *exc):
        if self.saved and os.path.exists(self.saved):
            shutil.move(self.saved, self.dotcfg)
        elif os.path.exists(self.dotcfg):
            os.remove(self.dotcfg)


# ----------------------------------------------------------------------------
# the one build recipe
# ----------------------------------------------------------------------------
def build_test_elf(build_dir, toolchain, quiet=True):
    """cmake -DTEST=ON [toolchain] && cmake --build --target tests. .config must
    already be seeded by a ConfigScope. Returns (ok, build_path)."""
    bp = os.path.join(REPO, build_dir)
    shutil.rmtree(bp, ignore_errors=True)
    cfg = ["cmake", "-B", build_dir, "-DTEST=ON"]
    if toolchain:
        cfg.append(f"-DCMAKE_TOOLCHAIN_FILE={toolchain}")
    out = subprocess.DEVNULL if quiet else None
    if run(cfg, stdout=out, stderr=out).returncode != 0:
        return False, bp
    if run(["cmake", "--build", build_dir, "--target", "tests", "-j"],
           stdout=out, stderr=out).returncode != 0:
        return False, bp
    return True, bp


# ----------------------------------------------------------------------------
# navtest output parser (the single source of truth for pass/fail)
# ----------------------------------------------------------------------------
_SUM_FAIL = re.compile(r"Total failures:\s*(\d+)")
_SUM_TOT = re.compile(r"Total tests run:\s*(\d+)")
_SUITE = re.compile(r"\[(\d+) tests \| (\d+) failed \| (\d+) passed\]")


def parse_navtest(text):
    """-> (found_summary, total, failures). failures=None if no summary line."""
    mf = _SUM_FAIL.search(text)
    mt = _SUM_TOT.search(text)
    if not mf:
        # host binaries have no 'Total failures' line; fall back to suite lines
        tot = fail = 0
        seen = False
        for m in _SUITE.finditer(text):
            seen = True
            tot += int(m.group(1))
            fail += int(m.group(2))
        return seen, tot, (fail if seen else None)
    return True, (int(mt.group(1)) if mt else 0), int(mf.group(1))


# ----------------------------------------------------------------------------
# result model + summary table
# ----------------------------------------------------------------------------
class Result:
    def __init__(self, name, ok, total=None, failed=None, note=""):
        self.name, self.ok, self.total, self.failed, self.note = \
            name, ok, total, failed, note


def summary(results):
    print(c("\n== summary ==", "bold"))
    w = max((len(r.name) for r in results), default=8)
    anyfail = False
    for r in results:
        if r.ok:
            tag = c("PASS", "g")
        else:
            tag = c("FAIL", "r")
            anyfail = True
        cnt = ""
        if r.total is not None:
            cnt = f"{r.total - (r.failed or 0)}/{r.total}"
        print(f"  {r.name.ljust(w)}  {tag}  {cnt.ljust(9)} {c(r.note, 'd')}")
    return not anyfail


